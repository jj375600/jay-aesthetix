# Copy this file to .env.local and fill in your values.
# Local Postgres (see README for a one-line Docker command):
DATABASE_URL=postgres://jay:jay@localhost:5432/jay_aesthetix
# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string
# Shows the "portfolio concept" disclaimer in the footer and on the booking pages.
NEXT_PUBLIC_DEMO_MODE=true

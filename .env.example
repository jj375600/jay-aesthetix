# Copy this file to .env.local and fill in your values.
# Local Postgres (see README for a one-line Docker command):
DATABASE_URL=postgres://jay:jay@localhost:5432/jay_aesthetix
# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string
# Shows the "portfolio concept" disclaimer in the footer and on the booking pages.
NEXT_PUBLIC_DEMO_MODE=true
# Optional: real email delivery through Resend (https://resend.com, free tier). Leave unset to only
# record emails in the trainer's Email log. Until you verify your own domain in Resend, it will only
# deliver to the email address of your Resend account.
RESEND_API_KEY=
EMAIL_FROM=JAY-AESTHETIX <onboarding@resend.dev>
# Optional: pay invoices with Stripe Checkout in TEST MODE (https://dashboard.stripe.com/test/apikeys).
# Only keys starting with sk_test_ are accepted; live keys are refused on purpose.
STRIPE_SECRET_KEY=
# From a webhook endpoint pointing at https://<your-site>/api/stripe/webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
# Optional: text-message reminders and daily check-ins from the separate jay-nudge bot
# (https://github.com/jj375600/jay-nudge). Leave both unset and the site works exactly as before.
# NUDGE_EVENTS_SECRET must be the same value as EVENTS_SECRET in the bot's own .env.
NUDGE_URL=
NUDGE_EVENTS_SECRET=
